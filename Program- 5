#include<stdio.h>

int main()
{
    int n,i,j,temp;
    int p[10];

    printf("Enter number of processes: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(p[i]>p[j])
            {
                temp=p[i];
                p[i]=p[j];
                p[j]=temp;
            }

    printf("Priority Order:\n");

    for(i=0;i<n;i++)
        printf("%d ",p[i]);

    return 0;
}

#include <stdio.h>

struct emp {
    int id;
    char name[20];
};

int main() {
    struct emp e;

    printf("Enter Employee ID: ");
    scanf("%d",&e.id);

    printf("Enter Name: ");
    scanf("%s",e.name);

    printf("\nEmployee Details\n");
    printf("ID = %d\n",e.id);
    printf("Name = %s\n",e.name);

    return 0;
}

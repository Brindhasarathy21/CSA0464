#include <stdio.h>

int main()
{
    int indexBlock, n, i, blocks[20];

    printf("Enter index block: ");
    scanf("%d", &indexBlock);

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &blocks[i]);

    printf("Index Block %d contains:\n", indexBlock);

    for(i = 0; i < n; i++)
        printf("%d ", blocks[i]);

    return 0;
}

#include<stdio.h>

int main()
{
    int pages[20], frames[10], n, f, i, j, faults = 0;

    printf("Enter no. of pages: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&pages[i]);

    printf("Enter no. of frames: ");
    scanf("%d",&f);

    for(i=0;i<f;i++)
        frames[i]=-1;

    for(i=0;i<n;i++)
    {
        int found=0;
        for(j=0;j<f;j++)
            if(frames[j]==pages[i])
                found=1;

        if(!found)
        {
            frames[faults%f]=pages[i];
            faults++;
        }
    }

    printf("Page Faults = %d",faults);
    return 0;
}
